    {
        "id": "170d48d2a4bb9e99",
        "type": "function",
        "z": "400bd4a025dc25eb",
        "name": "",
        "func": "let t = Date.now() / 1000;\n\nlet A = 10;   // амплітуда\nlet w = 0.5;  // частота\nlet C = 20;   // зміщення\n\nmsg.payload = A * Math.sin(w * t) + C;\n\nreturn msg;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 80,
        "wires": [
            [
                "92e9ae96f8f4184e",
                "a58e9fb81c75c817"
            ]
        ]
    },
    {
        "id": "d280d6327468dbb4",
        "type": "function",
        "z": "400bd4a025dc25eb",
        "name": "function 2",
        "func": "let t = Date.now()/1000;\nlet A=10;\nlet w=0.1;\nlet C=20;\n\nlet value = A*Math.sin(w*t)+C;\n\nmsg.payload = {\n    value: value\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 160,
        "wires": [
            [
                "cfa22b96cdc5e91b",
                "a58e9fb81c75c817"
            ]
        ]
    },
