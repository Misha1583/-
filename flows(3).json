    {
        "id": "bf66b50d7ab32110",
        "type": "function",
        "z": "bf8254855e4f5f96",
        "name": "Simulation (sin + peaks)",
        "func": "let t = Date.now()/1000;\nlet base = Math.sin(t);\nlet peak = Math.random()*0.5;\nlet power = (base+1+peak)*50;\n\nmsg.payload = {\n    time: new Date().toLocaleTimeString(),\n    power: parseFloat(power.toFixed(2))\n};\nreturn msg;",
        "outputs": 1,
        "x": 300,
        "y": 100,
        "wires": [
            [
                "33c37286a76f8c7c",
                "8392ee3ec9ad362f"
            ]
        ]
    },
    {
        "id": "33c37286a76f8c7c",
        "type": "function",
        "z": "bf8254855e4f5f96",
        "name": "State + Counter",
        "func": "let threshold = 60;\nlet power = msg.payload.power;\n\nmsg.payload.state = power > threshold ? \"ON\" : \"OFF\";\n\nlet prev = flow.get(\"prev\") || \"OFF\";\nlet count = flow.get(\"count\") || 0;\n\nif(msg.payload.state === \"ON\" && prev === \"OFF\"){\n    count++;\n}\n\nflow.set(\"prev\", msg.payload.state);\nflow.set(\"count\", count);\n\nmsg.payload.count = count;\nreturn msg;",
        "outputs": 1,
        "x": 520,
        "y": 100,
        "wires": [
            [
                "1ab0555bd0c17f48",
                "697ce04980f38e60",
                "42f7660fb97a3927"
            ]
        ]
    },
    {
        "id": "42f7660fb97a3927",
        "type": "function",
        "z": "bf8254855e4f5f96",
        "name": "To Log",
        "func": "msg.payload = JSON.stringify(msg.payload)+\"\\n\";\nreturn msg;",
        "outputs": 1,
        "x": 720,
        "y": 160,
        "wires": [
